def solve(a, b, c):
    """Функция возвращает корни квадратного уравнения ax^2 + bx + c = 0 
    в порядке возрастания."""
    # Дискриминант
    d = b ** 2 - 4 * a * c
    
    # Гарантируется, что уравнение имеет хотя бы один корень
    if d == 0:
        # Один корень
        x = -b / (2 * a)
        return x, x  # Возвращаем два одинаковых значения для единообразия
    else:
        # Два корня
        x1 = (-b + d ** 0.5) / (2 * a)
        x2 = (-b - d ** 0.5) / (2 * a)
        
        # Возвращаем в порядке возрастания
        if x1 < x2:
            return x1, x2
        else:
            return x2, x1

# Проверка работы
print(*solve(1, -4, -5))   # -1.0 5.0
print(*solve(-2, 7, -5))   # 1.0 2.5
print(*solve(1, 2, 1))     # -1.0 -1.0
