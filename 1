def get_days(month):
    """Функция возвращает количество дней в указанном месяце (невисокосный год)."""
    # Список дней для каждого месяца (индекс 0 не используется)
    days_in_months = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    return days_in_months[month]

# Проверка работы (как в примере)
print(get_days(1))
print(get_days(2))
print(get_days(9))
